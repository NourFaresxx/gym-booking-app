# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
# Leave empty to disable CORS entirely (server-to-server use only).
CLIENT_URL=http://localhost:3000

# Set when running behind a reverse proxy (Render, Railway, nginx) so rate
# limiting sees the real client IP. Usually the number of proxy hops, e.g. 1.
# TRUST_PROXY=1

# --- Database ---------------------------------------------------------------
# Transactions require a replica set. MongoDB Atlas provides one by default;
# a bare local `mongod` does not.
MONGODB_URI=mongodb://127.0.0.1:27017/booking-api

# --- Auth -------------------------------------------------------------------
# Must be two DIFFERENT long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Payments ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:5000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Booking behaviour ------------------------------------------------------
# How long a pending booking holds its seat before the sweeper releases it.
PENDING_BOOKING_TTL_MINUTES=15

# --- Rate limits (requests per 15 minutes) ---------------------------------
GLOBAL_RATE_LIMIT=1000
AUTH_RATE_LIMIT=20
REFRESH_RATE_LIMIT=60

# --- Email notifications (optional) ----------------------------------------
# With SMTP_HOST and MAIL_FROM unset, notifications are logged instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Elite Gym <no-reply@example.com>"
